APP_ENV=development
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_HANDLER_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
POSTGRES_PORT=5432
DATABASE_URL=postgres://flashflow:flashflow_dev@localhost:5432/flashflow?sslmode=disable

# Required secret. Development value only; replace outside local development.
JWT_SECRET=development-only-change-me
